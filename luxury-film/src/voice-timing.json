[
 {
  "start": 1.4,
  "end": 3.536,
  "text": "Всё начинается со света."
 },
 {
  "start": 6.0,
  "end": 6.43,
  "text": "Форма."
 },
 {
  "start": 7.3,
  "end": 7.927,
  "text": "Материал."
 },
 {
  "start": 8.6,
  "end": 9.134,
  "text": "Деталь."
 },
 {
  "start": 11.6,
  "end": 14.677,
  "text": "Из темноты рождается то, что выходит за рамки обычного."
 },
 {
  "start": 18.2,
  "end": 19.698,
  "text": "Каждая линия выверена."
 },
 {
  "start": 21.0,
  "end": 22.625,
  "text": "Каждое движение — точно."
 },
 {
  "start": 27.4,
  "end": 28.261,
  "text": "Вне времени."
 },
 {
  "start": 29.6,
  "end": 31.26,
  "text": "Создано, чтобы остаться."
 },
 {
  "start": 35.8,
  "end": 37.425,
  "text": "Скульптура из света."
 },
 {
  "start": 38.9,
  "end": 40.34,
  "text": "Обсидиан. Титан. Хром."
 },
 {
  "start": 46.3,
  "end": 46.857,
  "text": "Меньше."
 },
 {
  "start": 47.7,
  "end": 48.652,
  "text": "Но лучше."
 },
 {
  "start": 53.2,
  "end": 54.907,
  "text": "Совершенство не кричит."
 },
 {
  "start": 57.4,
  "end": 58.155,
  "text": "Обсидиан."
 }
