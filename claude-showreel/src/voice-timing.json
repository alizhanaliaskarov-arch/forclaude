[
 {
  "start": 1.2,
  "end": 3.328,
  "text": "Всё начинается с одного слова."
 },
 {
  "start": 9.6,
  "end": 12.181,
  "text": "Одно слово — и миллион возможностей."
 },
 {
  "start": 13.4,
  "end": 14.975,
  "text": "Привет. Я — Claude."
 },
 {
  "start": 18.3,
  "end": 19.693,
  "text": "Я пишу и считаю."
 },
 {
  "start": 22.1,
  "end": 23.558,
  "text": "Программирую и рисую."
 },
 {
  "start": 26.1,
  "end": 29.871,
  "text": "Сочиняю музыку и объясняю сложное простыми словами."
 },
 {
  "start": 32.2,
  "end": 33.321,
  "text": "Вместе с вами."
 },
 {
  "start": 34.5,
  "end": 36.148,
  "text": "Код — мой родной язык."
 },
 {
  "start": 37.0,
  "end": 40.148,
  "text": "Python, TypeScript, Rust, SQL."
 },
 {
  "start": 41.0,
  "end": 45.888,
  "text": "Я читаю целые проекты и нахожу ошибку, которую искали неделю."
 },
 {
  "start": 46.8,
  "end": 48.936,
  "text": "Пишу тесты — и они проходят."
 },
 {
  "start": 54.5,
  "end": 56.895,
  "text": "Дайте мне таблицу на миллион строк."
 },
 {
  "start": 57.9,
  "end": 59.74,
  "text": "Я найду тренд, аномалию"
 },
 {
  "start": 60.5,
  "end": 63.743,
  "text": "и ответ на вопрос, который вы ещё не задали."
 },
 {
  "start": 65.0,
  "end": 67.697,
  "text": "А потом соберу дашборд — за минуты."
 },
 {
  "start": 72.8,
  "end": 74.912,
  "text": "Я говорю на десятках языков."
 },
 {
  "start": 76.5,
  "end": 79.707,
  "text": "Переведу договор, письмо бабушке или шутку —"
 },
 {
  "start": 81.2,
  "end": 83.669,
  "text": "так, чтобы она осталась смешной."
 },
 {
  "start": 90.5,
  "end": 93.502,
  "text": "Я пишу всё: от делового письма до сонета."
 },
 {
  "start": 95.0,
  "end": 98.352,
  "text": "Сценарий, тост, статья, резюме."
 },
 {
  "start": 99.5,
  "end": 103.496,
  "text": "И меняю тон за секунду: строгий, тёплый, дерзкий."
 },
 {
  "start": 108.6,
  "end": 112.192,
  "text": "Математика, физика, химия, биология."
 },
 {
  "start": 113.0,
  "end": 115.218,
  "text": "Я решаю задачу шаг за шагом"
 },
 {
  "start": 115.8,
  "end": 118.783,
  "text": "и показываю, почему ответ именно такой."
 },
 {
  "start": 120.0,
  "end": 122.213,
  "text": "Не просто ответ — понимание."
 },
 {
  "start": 126.8,
  "end": 129.559,
  "text": "Сайт, интерфейс, презентация."
 },
 {
  "start": 130.0,
  "end": 132.913,
  "text": "От наброска на салфетке до готового макета —"
 },
 {
  "start": 134.3,
  "end": 136.58,
  "text": "с сеткой, палитрой и шрифтами."
 },
 {
  "start": 138.0,
  "end": 140.039,
  "text": "За минуты, а не за недели."
 },
 {
  "start": 144.4,
  "end": 146.383,
  "text": "А ещё я умею работать сам."
 },
 {
  "start": 147.4,
  "end": 150.92,
  "text": "Делю большую задачу на шаги и запускаю помощников,"
 },
 {
  "start": 152.6,
  "end": 154.296,
  "text": "проверяю каждый результат"
 },
 {
  "start": 155.4,
  "end": 157.82,
  "text": "и докладываю, когда всё готово."
 },
 {
  "start": 162.6,
  "end": 164.201,
  "text": "«А почему небо голубое?»"
 },
 {
  "start": 165.2,
  "end": 168.59,
  "text": "Объясню что угодно — ребёнку или профессору."
 },
 {
  "start": 170.2,
  "end": 173.492,
  "text": "Столько раз, сколько нужно. Без осуждения."
 },
 {
  "start": 178.6,
  "end": 179.545,
  "text": "И я честен."
 },
 {
  "start": 180.6,
  "end": 183.193,
  "text": "Если я не знаю — я так и скажу."
 },
 {
  "start": 185.6,
  "end": 187.357,
  "text": "Ваши данные — ваши."
 },
 {
  "start": 188.2,
  "end": 191.173,
  "text": "А безопасность — не опция, а основа."
 },
 {
  "start": 194.4,
  "end": 195.802,
  "text": "А теперь — секрет."
 },
 {
  "start": 197.4,
  "end": 199.553,
  "text": "В этом ролике нет ни одной камеры."
 },
 {
  "start": 201.0,
  "end": 204.166,
  "text": "Ни одной фотографии. Ни одного чужого звука."
 },
 {
  "start": 206.6,
  "end": 209.498,
  "text": "Каждый кадр, каждую ноту и каждое слово —"
 },
 {
  "start": 210.8,
  "end": 213.548,
  "text": "9 000 кадров. 17 сцен."
 },
 {
  "start": 215.9,
  "end": 217.18,
  "text": "я написал кодом."
 },
 {
  "start": 217.6,
  "end": 218.054,
  "text": "Сам."
 },
 {
  "start": 218.5,
  "end": 219.727,
  "text": "Вот что я умею."
 },
 {
  "start": 244.0,
  "end": 245.326,
  "text": "И это только начало."
 },
 {
  "start": 246.5,
  "end": 248.084,
  "text": "А теперь главный вопрос:"
 },
 {
  "start": 248.8,
  "end": 250.154,
  "text": "что создадите вы?"
 },
 {
  "start": 251.6,
  "end": 254.354,
  "text": "Бизнес-план к утру. Экзамен без паники."
 },
 {
  "start": 256.4,
  "end": 257.969,
  "text": "Песню на мамин юбилей."
 },
 {
  "start": 260.0,
  "end": 262.473,
  "text": "Я — инструмент. Идея — ваша."
 },
 {
  "start": 264.6,
  "end": 265.927,
  "text": "Давайте начнём."
 },
 {
  "start": 272.2,
  "end": 272.602,
  "text": "Claude."
 },
 {
  "start": 274.8,
  "end": 275.685,
  "text": "Думай шире."
 },
 {
  "start": 279.6,
  "end": 281.736,
  "text": "Одно слово — и всё возможно."
 }
]